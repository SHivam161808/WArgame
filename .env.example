# Copy to .env — all variables are optional except DATABASE_URL.
DATABASE_URL=postgres://wargame@127.0.0.1:5433/wargame
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# DEBUG=0
# SECRET_KEY=change-me
# ALLOWED_HOSTS=wargame.example.com
# CSRF_TRUSTED_ORIGINS=https://wargame.example.com
# HTTPS=1
# REDIS_URL=redis://localhost:6379/0          # multi-process channel layer (channels-redis)
# LLM_BASE_URL=http://localhost:11434          # self-hosted FOSS model (Ollama / llama.cpp / vLLM)
# LLM_MODEL=llama3.1:8b
# OFFLINE_TERRAIN=1                            # use only cached elevation tiles
